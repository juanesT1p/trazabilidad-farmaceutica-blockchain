{
  "name": "pharma-chain-pqc-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Academic prototype for pharmaceutical custody traceability with ML-DSA signatures.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "compile": "hardhat compile",
    "dev": "tsx src/server.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "npm run test:contract && npm run test:unit",
    "test:contract": "hardhat test",
    "test:unit": "vitest run --coverage",
    "measure:crypto": "tsx scripts/measure-crypto.ts",
    "measure:gas": "tsx scripts/measure-gas.ts",
    "measure:confirmation": "tsx scripts/measure-confirmation-testnet.ts"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "@prisma/client": "7.10.1",
    "canonicalize": "2.1.0",
    "dotenv": "18.0.8",
    "ethers": "6.17.0",
    "express": "5.3.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@prisma/client": "7.10.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "hardhat": "3.20.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
